rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Custom claim aplicada só pelo Admin SDK (definir-admin.js). Um campo
    // "admin" em usuarios não vale: o próprio usuário consegue gravar lá.
    function ehAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // tipoUsuario só pode ser definido uma vez (onboarding); depois de
    // setado, não pode ser trocado (musico <-> casaShow), para não deixar
    // perfis_musicos/estabelecimentos órfãos.
    function tipoUsuarioNaoMudou() {
      return !('tipoUsuario' in resource.data) ||
        (
          ('tipoUsuario' in request.resource.data) &&
          request.resource.data.tipoUsuario == resource.data.tipoUsuario
        );
    }

    match /usuarios/{userId} {
      allow read, create, delete: if isOwner(userId);
      allow update: if isOwner(userId) && tipoUsuarioNaoMudou();

      // Favoritos (Plano 18): privados do dono; id = {tipo}_{alvoId}.
      match /favoritos/{favoritoId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['tipo', 'alvoId', 'criadoEm'])
          && request.resource.data.tipo in ['musico', 'oportunidade']
          && request.resource.data.alvoId is string
          && favoritoId == request.resource.data.tipo + '_' + request.resource.data.alvoId;
      }
    }

    // Plano 7: quem é assinante. Público para ordenar as listas; só o Admin
    // SDK grava (definir-assinante.js), para ninguém se marcar sozinho.
    match /assinantes/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /perfis_musicos/{userId} {
      // Miniatura em base64 no próprio perfil (Plano 14): limitada para o
      // catálogo, que todos baixam inteiro, não pesar (o app reduz a 256 px).
      function fotoValida() {
        return !('foto' in request.resource.data)
          || request.resource.data.foto == null
          || (request.resource.data.foto is string
              && request.resource.data.foto.size() <= 200000);
      }

      allow read: if signedIn();
      allow create, update: if isOwner(userId) && fotoValida();
      allow delete: if isOwner(userId);
    }

    // Perfil público do estabelecimento (Plano 16): qualquer autenticado lê.
    // Contato e CNPJ não podem ficar aqui — vão para privado/dados.
    match /estabelecimentos/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['contato', 'cnpj']);
      allow delete: if isOwner(userId);

      // Contato e CNPJ: o dono e quem já conversa com ele (a conversa do
      // par só nasce de um interesse aceito; id = os dois uids em ordem).
      match /privado/{docId} {
        function conversam() {
          let eu = request.auth.uid;
          let par = eu < userId ? eu + '_' + userId : userId + '_' + eu;
          return exists(/databases/$(database)/documents/conversas/$(par));
        }

        allow read: if signedIn() && (request.auth.uid == userId || conversam());
        allow create, update: if isOwner(userId)
          && docId == 'dados'
          && request.resource.data.keys().hasOnly(['contato', 'cnpj']);
        allow delete: if isOwner(userId);
      }
    }

    match /oportunidades/{oportunidadeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.donoId == request.auth.uid;
      allow update, delete: if ehAdmin()
        || (signedIn() && resource.data.donoId == request.auth.uid);
    }

    function tipoDoUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipoUsuario;
    }

    function donoDaOportunidade(oportunidadeId) {
      return get(/databases/$(database)/documents/oportunidades/$(oportunidadeId)).data.donoId;
    }

    // Plano 12: o evento ainda não passou. `dataEvento` é o dia à meia-noite
    // local; vale até 24 h depois dela (o próprio dia do evento ainda conta).
    function oportunidadeVigente(oportunidadeId) {
      return request.time < get(/databases/$(database)/documents/oportunidades/$(oportunidadeId)).data.dataEvento
        + duration.value(1, 'd');
    }

    // Candidatura: músico -> oportunidade; o destinatário é o dono dela.
    function candidaturaValida(d) {
      return d.tipo == 'candidatura'
        && (ehAdmin() || tipoDoUsuario() == 'musico')
        && d.musicoId == request.auth.uid
        && d.oportunidadeId is string
        && donoDaOportunidade(d.oportunidadeId) == d.destinatarioId
        && oportunidadeVigente(d.oportunidadeId);
    }

    // Convite: dono -> músico de verdade (catálogo de demonstração não tem
    // conta em usuarios); se citar uma oportunidade, tem que ser dele.
    function conviteValido(d) {
      return d.tipo == 'convite'
        && (ehAdmin() || tipoDoUsuario() == 'casaShow')
        && d.destinatarioId == d.musicoId
        && get(/databases/$(database)/documents/usuarios/$(d.musicoId)).data.tipoUsuario == 'musico'
        && (!('oportunidadeId' in d)
          || (donoDaOportunidade(d.oportunidadeId) == request.auth.uid
            && oportunidadeVigente(d.oportunidadeId)));
    }

    match /interesses/{interesseId} {
      allow read: if signedIn()
        && (resource.data.remetenteId == request.auth.uid
          || resource.data.destinatarioId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.remetenteId == request.auth.uid
        && request.resource.data.destinatarioId != request.auth.uid
        && request.resource.data.status == 'pendente'
        && (candidaturaValida(request.resource.data)
          || conviteValido(request.resource.data));
      // Só o destinatário responde, uma vez, e só mexe na resposta.
      allow update: if signedIn()
        && resource.data.destinatarioId == request.auth.uid
        && resource.data.status == 'pendente'
        && request.resource.data.status in ['aceito', 'recusado']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'respondidoEm', 'conversaId']);
      // Ou o remetente encerra (sem apagar) o convite pendente — usado quando
      // o dono remove a oportunidade: o músico ainda vê "Cancelado".
      allow update: if signedIn()
        && resource.data.remetenteId == request.auth.uid
        && resource.data.status == 'pendente'
        && request.resource.data.status == 'cancelado'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'respondidoEm']);
      // Cancelar = o remetente apaga enquanto ninguém respondeu.
      allow delete: if signedIn()
        && resource.data.remetenteId == request.auth.uid
        && resource.data.status == 'pendente';
    }

    // A conversa nasce quando o destinatário aceita um interesse (mesmo id,
    // mesmo batch) e só os dois participantes enxergam ou escrevem nela.
    match /conversas/{conversaId} {
      // Uma conversa por par de usuários: id = os dois uids em ordem.
      // Nasce (ou é recriada) a partir de um interesse aceito entre os dois;
      // `interesseId` aponta o interesse que justifica a criação.
      function interesseDoPar() {
        return getAfter(/databases/$(database)/documents/interesses/$(request.resource.data.interesseId)).data;
      }

      function parOrdenado(i) {
        return i.remetenteId < i.destinatarioId
          ? [i.remetenteId, i.destinatarioId]
          : [i.destinatarioId, i.remetenteId];
      }

      allow read: if signedIn()
        && request.auth.uid in resource.data.participantes;
      allow create: if signedIn()
        && request.resource.data.interesseId is string
        && interesseDoPar().status == 'aceito'
        && request.auth.uid in [interesseDoPar().remetenteId, interesseDoPar().destinatarioId]
        && request.resource.data.participantes == parOrdenado(interesseDoPar())
        && conversaId == parOrdenado(interesseDoPar())[0] + '_' + parOrdenado(interesseDoPar())[1];
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantes
        && request.resource.data.participantes == resource.data.participantes;
    }

    // Contratação (9B): o dono propõe a partir de um interesse aceito em que é
    // parte; o músico confirma ou recusa. Só as duas partes leem.
    match /contratacoes/{contratacaoId} {
      function parte() {
        return request.auth.uid == resource.data.musicoId
          || request.auth.uid == resource.data.donoId;
      }

      function propostaValida(d) {
        let i = get(/databases/$(database)/documents/interesses/$(d.interesseId)).data;
        return d.donoId == request.auth.uid
          && d.musicoId != request.auth.uid
          && d.status == 'proposta'
          && d.dia is string
          && d.dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && i.status == 'aceito'
          && i.musicoId == d.musicoId
          && ((i.tipo == 'convite' && i.remetenteId == request.auth.uid)
            || (i.tipo == 'candidatura' && i.destinatarioId == request.auth.uid));
      }

      function mudou() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function vaiPara(de, para) {
        return resource.data.status == de && request.resource.data.status == para;
      }

      // Trava do dia (id = {musicoId}_{dia}), criada/apagada no mesmo batch.
      function ocupacao() {
        return /databases/$(database)/documents/ocupacoes/$(resource.data.musicoId + '_' + resource.data.dia);
      }

      function cancelamentoValido() {
        return mudou().hasOnly(['status', 'canceladoEm', 'canceladoPor', 'motivoCancelamento'])
          && request.resource.data.canceladoPor == request.auth.uid;
      }

      allow read: if signedIn() && parte();
      allow create: if signedIn() && propostaValida(request.resource.data);
      allow update: if signedIn() && parte() && (
        // músico confirma: o dia precisa ficar travado para esta contratação
        (vaiPara('proposta', 'confirmada')
          && request.auth.uid == resource.data.musicoId
          && mudou().hasOnly(['status', 'respondidoEm'])
          && getAfter(ocupacao()).data.contratacaoId == contratacaoId)
        // músico recusa
        || (vaiPara('proposta', 'recusada')
          && request.auth.uid == resource.data.musicoId
          && mudou().hasOnly(['status', 'respondidoEm']))
        // dono retira a proposta
        || (vaiPara('proposta', 'cancelada')
          && request.auth.uid == resource.data.donoId
          && cancelamentoValido())
        // qualquer parte desfaz a confirmada: o dia tem que ser liberado junto
        || (vaiPara('confirmada', 'cancelada')
          && cancelamentoValido()
          && !existsAfter(ocupacao()))
      );
    }

    // "Ocupado" público: uma trava por músico por dia. Criar sobre uma trava
    // existente é update (proibido) — é isso que impede dois shows no dia.
    match /ocupacoes/{ocupacaoId} {
      function contratacao(id) {
        return getAfter(/databases/$(database)/documents/contratacoes/$(id)).data;
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['musicoId', 'dia', 'contratacaoId'])
        && request.resource.data.musicoId == request.auth.uid
        && ocupacaoId == request.resource.data.musicoId + '_' + request.resource.data.dia
        && contratacao(request.resource.data.contratacaoId).status == 'confirmada'
        && contratacao(request.resource.data.contratacaoId).musicoId == request.auth.uid
        && contratacao(request.resource.data.contratacaoId).dia == request.resource.data.dia;
      allow delete: if signedIn()
        && contratacao(resource.data.contratacaoId).status == 'cancelada'
        && (request.auth.uid == contratacao(resource.data.contratacaoId).musicoId
          || request.auth.uid == contratacao(resource.data.contratacaoId).donoId);
    }

    // Avisos dentro do app (Plano 11). Só se notifica a outra parte de um
    // interesse em comum (interesse, conversa e contratação derivam dele).
    match /notificacoes/{notificacaoId} {
      function vinculada(d) {
        let i = get(/databases/$(database)/documents/interesses/$(d.interesseId)).data;
        return [i.remetenteId, i.destinatarioId].hasAll([request.auth.uid, d.destinatarioId]);
      }

      allow read, delete: if signedIn()
        && resource.data.destinatarioId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.destinatarioId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'destinatarioId', 'autorId', 'autorNome', 'tipo', 'titulo', 'texto',
          'interesseId', 'oportunidadeId', 'contratacaoId', 'lida', 'criadaEm'])
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.destinatarioId != request.auth.uid
        && request.resource.data.lida == false
        && request.resource.data.interesseId is string
        && vinculada(request.resource.data);
    }

    // Avaliação pós-show (Plano 17): uma por parte da contratação, sem
    // editar nem apagar. Leitura pública (reputação).
    match /avaliacoes/{avaliacaoId} {
      // Meia-noite de Brasília (UTC-3) do dia seguinte ao show: a
      // contratação guarda o dia como texto `yyyy-MM-dd`.
      function abreAvaliacao(dia) {
        let p = dia.split('-');
        return timestamp.date(int(p[0]), int(p[1]), int(p[2]))
          + duration.value(27, 'h');
      }

      function avaliacaoValida(d) {
        let c = get(/databases/$(database)/documents/contratacoes/$(d.contratacaoId)).data;
        let abre = abreAvaliacao(c.dia);
        return c.status == 'confirmada'
          && ((c.musicoId == d.autorId && c.donoId == d.avaliadoId)
            || (c.donoId == d.autorId && c.musicoId == d.avaliadoId))
          && request.time >= abre
          && request.time < abre + duration.value(30, 'd');
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'contratacaoId', 'autorId', 'autorNome', 'avaliadoId', 'nota',
          'comentario', 'criadaEm'])
        && request.resource.data.autorId == request.auth.uid
        && avaliacaoId == request.resource.data.contratacaoId + '_' + request.auth.uid
        && request.resource.data.nota is int
        && request.resource.data.nota >= 1
        && request.resource.data.nota <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() <= 300
        && avaliacaoValida(request.resource.data);
    }

    // Dias que o músico bloqueou na agenda (todo dia é livre por padrão).
    // Leitura pública (agenda do músico no detalhe, avisos e filtro); escrita
    // só do próprio usuário.
    match /bloqueios/{bloqueioId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.usuarioId == request.auth.uid;
    }
  }
}
