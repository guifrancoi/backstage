rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // tipoUsuario só pode ser definido uma vez (onboarding); depois de
    // setado, não pode ser trocado (musico <-> casaShow), para não deixar
    // perfis_musicos/estabelecimentos órfãos.
    function tipoUsuarioNaoMudou() {
      return !('tipoUsuario' in resource.data) ||
        (
          ('tipoUsuario' in request.resource.data) &&
          request.resource.data.tipoUsuario == resource.data.tipoUsuario
        );
    }

    match /usuarios/{userId} {
      allow read, create, delete: if isOwner(userId);
      allow update: if isOwner(userId) && tipoUsuarioNaoMudou();
    }

    match /perfis_musicos/{userId} {
      allow read: if signedIn();
      allow write: if isOwner(userId);
    }

    match /estabelecimentos/{userId} {
      allow read: if signedIn();
      allow write: if isOwner(userId);
    }

    match /oportunidades/{oportunidadeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.donoId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.donoId == request.auth.uid;
    }

    // Sem vínculo a participantes reais ainda (Conversa só tem nomeContato +
    // mensagens embutidas) — restringir por participante é redesenho do
    // chat, fora deste plano.
    match /conversas/{conversaId} {
      allow read, write: if signedIn();
    }

    match /interesses_oportunidades/{interesseId} {
      allow read: if signedIn() && resource.data.usuarioId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.usuarioId == request.auth.uid;
    }

    match /interesses_musicos/{interesseId} {
      allow read: if signedIn() && resource.data.usuarioId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.usuarioId == request.auth.uid;
    }

    match /disponibilidades/{disponibilidadeId} {
      allow read: if signedIn() && resource.data.usuarioId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.usuarioId == request.auth.uid;
    }
  }
}
