{
  "name": "backstage",
  "version": "1.0.0",
  "description": "Aplicativo Flutter do prototipo Backstage, preparado para rodar com dados\r locais durante desenvolvimento e com integracao real usando Firebase\r Authentication, Cloud Firestore e Firebase Hosting.",
  "main": "index.js",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:rules:run": "node --test rules-tests/firestore.rules.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"npm run test:rules:run\"",
    "test:restore:run": "node --test restore.test.js",
    "test:restore": "firebase emulators:exec --only firestore \"npm run test:restore:run\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "firebase-admin": "^14.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0"
  }
}
